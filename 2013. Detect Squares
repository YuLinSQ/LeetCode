class DetectSquares(object):

    def __init__(self):
        self.c = Counter()

    def add(self, point):
        """
        :type point: List[int]
        :rtype: None
        """
        self.c[tuple(point)]+=1

    def count(self, point):
        """
        :type point: List[int]
        :rtype: int
        """
        ans = 0
        x1,y1 = point
        for (x3,y3), cnt in self.c.items():
            if abs(x1-x3) == 0 or abs(x1-x3) != abs(y1-y3):
                continue
            ans+=cnt*self.c[(x1,y3)]*self.c[(x3,y1)]
        return ans


